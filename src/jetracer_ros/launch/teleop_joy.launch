<?xml version="1.0"?>
<launch>
    <!-- 1. Physical Hardware Drivers -->
    <include file="$(find jetracer)/launch/maste ter_hardware.launch" />

    <!-- 2. Joystick Driver -->
    <node pkg="joy" type="joy_node" name="joy_node" output="screen">
        <param name="dev" value="/dev/input/js0" />
        <param name="deadzone" value="0.12" />
        <param name="autorepeat_rate" value="20" />
    </node>

    <!-- 3. Teleop Logic -->
    <node pkg="jetracer" type="teleop_joy.py" name="teleop_joy" output="screen">
        <param name="x_speed" value="0.4" /> <!-- Adjust maximum linear speed here -->
        <param name="w_speed" value="1.2" /> <!-- Adjust maximum steering speed here -->
    </node>
</launch>
