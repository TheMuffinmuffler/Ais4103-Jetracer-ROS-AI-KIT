<?xml version="1.0"?>


<!--
  This launch file starts the full marker-based navigation setup used after mapping. It loads the saved map, starts AMCL localization, starts move_base, enables ArUco-based localization support, and starts marker_goal_navigator.py so that a marker ID published on /target_marker_id can be converted into a move_base navigation goal.

  My contribution:
  I assembled and adapted this launch file to integrate the localization and
  navigation components for the JetRacer project.

  AI assistance declaration:
  ChatGPT was used as support for organizing the launch structure and checking
  how the ROS nodes, parameters, map file, ArUco waypoint YAML, AMCL, move_base,
  and marker-goal navigation should be connected.

  External ROS components:
  - map_server is a standard ROS map-loading node.
  - amcl is a standard ROS localization node.
  - move_base is a standard ROS navigation node.
  - tf/static_transform_publisher is a standard ROS TF utility.
  - teb_local_planner, costmap configuration, and AMCL configuration are loaded
    as external ROS navigation configuration components.

  Project-specific components:
  - aruco_processor.py
  - marker_goal_navigator.py
  - saved map YAML
  - aruco_waypoints.yaml
-->


<launch>
    <arg name="map_file" default="/home/jetson/catkin_ws/src/Ais4103-Jetracer-ROS-AI-KIT/src/ris/map/mymap.yaml"/>
    <arg name="aruco_yaml" default="/home/jetson/catkin_ws/src/Ais4103-Jetracer-ROS-AI-KIT/src/ris/map/aruco_waypoints.yaml"/>
    <param name="use_sim_time" value="false"/>
    <node pkg="tf" type="static_transform_publisher" name="base_footprint_to_camera"
          args="0.190 0.0 0.111 0.0 0.0 0.0 base_footprint csi_cam_0_link 20" />
    <node name="map_server"
          pkg="map_server"
          type="map_server"
          args="$(arg map_file)"
          output="screen" />
    <node pkg="amcl" type="amcl" name="amcl" output="screen" clear_params="true">
        <rosparam file="$(find ris)/config/navigation/amcl.yaml" command="load"/>
        <remap from="scan" to="/scan"/>
    </node>

    <node pkg="move_base" type="move_base" name="move_base" output="screen" clear_params="true">
        <rosparam file="$(find ris)/config/navigation/costmap_common.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find ris)/config/navigation/costmap_common.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find ris)/config/navigation/global_costmap.yaml" command="load"/>
        <rosparam file="$(find ris)/config/navigation/local_costmap.yaml" command="load"/>
        <rosparam file="$(find ris)/config/navigation/move_base.yaml" command="load"/>
        <rosparam file="$(find ris)/config/navigation/teb_local_planner.yaml" command="load"/>
    </node>

    <node pkg="ris"
          type="aruco_processor.py"
          name="aruco_processor"
          output="screen">
        <param name="camera_name" value="/csi_cam_0"/>
        <param name="marker_size" value="0.0345"/>
        <param name="yaml_path" value="$(arg aruco_yaml)"/>
        <param name="base_frame" value="base_footprint"/>
        <param name="enable_mapping" value="false"/>
        <param name="enable_localization" value="true"/>
        <param name="bootstrap_marker_id" value="1"/>
        <param name="bootstrap_only_once" value="true"/>
        <param name="process_every_n_frames" value="2"/>
        <param name="localization_cooldown_sec" value="20.0"/>
        <param name="min_marker_distance_m" value="0.10"/>
        <param name="max_marker_distance_m" value="1.50"/>
        <param name="required_consecutive_detections" value="5"/>
    </node>

    <node pkg="ris"
          type="marker_goal_navigator.py"
          name="marker_goal_navigator"
          output="screen">
        <param name="yaml_path" value="$(arg aruco_yaml)"/>
        <param name="map_frame" value="map"/>
        <param name="move_base_action" value="/move_base"/>
        <param name="goal_topic" value="/target_marker_id"/>
        <param name="wait_for_server_sec" value="120.0"/>
        <param name="goal_timeout_sec" value="120.0"/>
        <param name="use_heading_to_goal" value="true"/>
    </node>
</launch>
